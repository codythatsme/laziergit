{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "laziergit-workspace",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "extensions/*"
    ],
    "catalog": {
      "@kitlangton/terminal-control": "0.6.0",
      "@kitlangton/terminal-control-opentui": "0.6.0",
      "@opentui/core": "0.4.4",
      "@opentui/keymap": "0.4.4",
      "@opentui/react": "0.4.4",
      "@types/bun": "1.3.5",
      "@types/react": "19.2.0",
      "effect": "4.0.0-beta.83",
      "oxfmt": "0.41.0",
      "oxlint": "1.74.0",
      "oxlint-tsgolint": "0.25.0",
      "react": "19.2.0",
      "typescript": "5.9.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun packages/core/src/main.tsx",
    "format": "oxfmt --write packages extensions scripts package.json tsconfig.base.json .oxfmtrc.json .oxlintrc.json",
    "format:check": "oxfmt --check packages extensions scripts package.json tsconfig.base.json .oxfmtrc.json .oxlintrc.json",
    "lint": "oxlint packages extensions scripts",
    "precommit": "bun run format:check && bun run lint && bun run typecheck",
    "prepare": "git config core.hooksPath .githooks",
    "test": "bun test ./packages",
    "test:e2e": "bun test ./scripts/e2e",
    "test:runtime": "bun packages/core/src/extension/reload.fixture.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@kitlangton/terminal-control": "catalog:",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "overrides": {
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/react": "catalog:"
  },
  "packageManager": "bun@1.3.5"
}
